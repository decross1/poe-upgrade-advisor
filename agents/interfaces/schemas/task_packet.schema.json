{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poe-upgrade-advisor/task-packet.schema.json",
  "title": "TaskPacket",
  "description": "A bounded execution contract for one autonomous task. v1 carries ONLY fields the dispatcher mechanically enforces (HANDOFF 2.5) — a field the dispatcher does not read is documentation, not control. Do not add fields here without a corresponding enforcement site.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "owner_role",
    "tier",
    "objective",
    "files_in_scope",
    "files_out_of_scope",
    "required_checks",
    "acceptance_criteria",
    "budgets"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },

    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]+(-S[0-9]+)?$",
      "description": "Stage identity: TASK-210-S1 is a stage of TASK-210. A stage may merge and close WITHOUT closing its parent."
    },
    "parent_task_id": { "type": ["string", "null"], "pattern": "^TASK-[0-9]+$" },
    "issue": { "type": ["integer", "null"], "minimum": 1 },

    "owner_role": { "enum": ["pm", "backend", "frontend"] },
    "tier": {
      "enum": ["green", "yellow", "red"],
      "description": "Selects the execution_classes defaults in agents/governor/policy.yaml. Packet budgets override, but may only tighten, never loosen."
    },

    "objective": { "type": "string", "minLength": 10, "maxLength": 2000 },

    "preconditions": {
      "type": "array",
      "default": [],
      "description": "Zero-token gates evaluated by preflight BEFORE any model call. This is the field that pays for the whole schema (audit 6.2).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check"],
        "properties": {
          "check": {
            "enum": [
              "issue_state",
              "issue_labels",
              "labels_for_scope",
              "blocker_fingerprint",
              "review_not_complete_at_head",
              "resource_lock",
              "baseline_checks"
            ]
          },
          "expect": { "type": ["string", "null"] },
          "require": { "type": "array", "items": { "type": "string" } },
          "forbid": { "type": "array", "items": { "type": "string" } },
          "require_if_touching": { "type": "object", "additionalProperties": { "type": "string" } },
          "skip_if_unchanged_since": { "type": ["string", "null"] }
        }
      }
    },

    "files_in_scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "files_out_of_scope": { "type": "array", "items": { "type": "string" } },

    "constraints": { "type": "array", "default": [], "items": { "type": "string" } },
    "forbidden_actions": { "type": "array", "default": [], "items": { "type": "string" } },

    "deterministic_prepass": {
      "type": "array",
      "default": [],
      "description": "T0 commands run before the model sees the tree (ruff --fix, prettier, codegen). Zero model tokens.",
      "items": { "type": "string" }
    },

    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
          "text": { "type": "string", "minLength": 5 }
        }
      }
    },

    "required_checks": {
      "type": "array",
      "minItems": 1,
      "description": "Shell commands the dispatcher runs itself. Authoritative — the model does not self-certify.",
      "items": { "type": "string" }
    },

    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "max_files_modified", "max_diff_lines", "max_wall_clock_seconds"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 },
        "max_files_modified": { "type": "integer", "minimum": 1 },
        "max_diff_lines": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": ["integer", "null"], "minimum": 1 },
        "max_wall_clock_seconds": { "type": "integer", "minimum": 60, "maximum": 3600 },
        "cost_ceiling_usd": { "type": ["number", "null"], "minimum": 0 },
        "value_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },

    "routing": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "reasoning_effort": { "enum": ["low", "medium", "high"] },
        "review_only_if": { "type": "array", "items": { "type": "string" } }
      }
    },

    "rollback": { "type": ["string", "null"] }
  }
}
