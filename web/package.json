{
  "name": "poe-upgrade-advisor-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tier-2/3 web UI + temporary fixture mock server (TASK-206). The mock (web/mock/) is deleted when TASK-202 lands.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run && node --import tsx --test mock/mock.test.mjs",
    "test:ui": "vitest run",
    "test:mock": "node --import tsx --test mock/mock.test.mjs",
    "gen:types": "openapi-typescript ../contracts/openapi.yaml -o src/lib/api-types.ts",
    "mock": "node mock/server.mjs",
    "generate:client": "openapi --input ../contracts/openapi.yaml --output src/generated --client fetch"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.4",
    "openapi-typescript-codegen": "^0.29.0",
    "tsx": "^4.23.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  }
}
