{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "verdict-overlay-bench",
  "version": "0.1.0",
  "identifier": "com.poeua.bench",
  "build": {
    "frontendDist": "../shared"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "verdict card (bench)",
        "width": 420,
        "height": 260,
        "useContentSize": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
